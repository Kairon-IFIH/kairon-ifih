# Copy to .env for local development.
# Point this at your local Postgres (matches docker-compose.yml's postgres
# service too, if you use that instead of a host-installed Postgres) then run
# `npm run db:migrate` and `npm run seed`.
DATABASE_URL=postgresql://postgres:root@localhost:5432/kairon
JWT_SECRET=dev-only-insecure-secret-change-me
PORT=3000
